<?xml version="1.0" encoding="utf-8"?>
<!--
  This file is used by IIS to host the app via the ASP.NET Core Module V2 (ANCM).
  The .NET SDK transforms this template on every `dotnet publish`, filling in the
  correct processPath/arguments for the build configuration - do not remove it or
  the SDK will silently regenerate a bare-bones default without these settings.

  Requires the "ASP.NET Core Hosting Bundle" to be installed on the IIS server
  (installs the native aspnetcorev2.dll IIS module) - see README "IIS Deployment".
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath=".\PdfBatchSignatureApi.exe" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
